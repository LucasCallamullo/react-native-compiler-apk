### Variables de entorno
@baseUrl = http://localhost:8080/api/v1/files

@apiAuth = http://localhost:8080/api/v1/auth

### 1. Login as USER (test@gmail.com)
# @name loginUser
POST {{apiAuth}}/login
Content-Type: application/json

{
    "email": "test@gmail.com",
    "password": "123456"
}

### set token user
@authToken = {{loginUser.response.body.data.accessToken}}

### 1b. Login as ADMIN (admin@gmail.com)
# @name loginAdmin
POST {{apiAuth}}/login
Content-Type: application/json

{
    "email": "admin@gmail.com",
    "password": "123456"
}

### set token admin
@adminToken = {{loginAdmin.response.body.data.accessToken}}


### ===========================================================
#        ENDPOIINTS FILES STORED
### ===========================================================

# Reemplazar con el ID devuelto en la respuesta del upload:
@uuidName = a62b0bbf-65a4-41cb-8859-4399f7b8e050


### 1. Subir archivo de texto (test.txt)
POST {{baseUrl}}/upload
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="test.txt"
Content-Type: text/plain

< ./test.txt
--WebAppBoundary--


### Subir imagen PNG (despliegue.png)
POST {{baseUrl}}/upload
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="despliegue.png"
Content-Type: image/png

< ./despliegue.png
--WebAppBoundary--


### Subir archivo PDF (Mantenimiento.pdf)
POST {{baseUrl}}/upload
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="Mantenimiento.pdf"
Content-Type: application/pdf

< ./Mantenimiento.pdf
--WebAppBoundary--


### Subir HTML (presupuesto.html)
POST {{baseUrl}}/upload
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="presupuesto.html"
Content-Type: text/html

< ./presupuesto.html
--WebAppBoundary--


### Subir Imagen JPEG (imagen.jpeg)
POST {{baseUrl}}/upload
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="imagen.jpeg"
Content-Type: image/jpeg

< ./imagen.jpeg
--WebAppBoundary--


### Subir Planilla Excel (planilla.xlsx)
POST {{baseUrl}}/upload
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="planilla.xlsx"
Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

< ./planilla.xlsx
--WebAppBoundary--


### Subir Video MP4 (video.mp4)
POST {{baseUrl}}/upload
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="video.mp4"
Content-Type: video/mp4

< ./video.mp4
--WebAppBoundary--


### 2. Listar todos los archivos del usuario autenticado
GET {{baseUrl}}
Authorization: Bearer {{authToken}}
Accept: application/json


### 3. Descargar / Visualizar archivo por ID
GET {{baseUrl}}/{{uuidName}}
Authorization: Bearer {{authToken}}


### 4. Eliminar archivo por ID
DELETE {{baseUrl}}/{{uuidName}}
Authorization: Bearer {{authToken}}