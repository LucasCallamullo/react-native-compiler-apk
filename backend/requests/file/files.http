### ============================================================
### File API - Pruebas del FileController
### Base URL: http://localhost:8080/api/v1/files
### ============================================================

@baseUrl = http://localhost:8080
@apiPath = /api/v1/files

### IDs de ejemplo - reemplaza por UUIDs reales de tu BD
@userId = 5b844bdc-b7c0-4f7e-86ad-a3d9cf7cbab9
@userId2 = 30dbe3129-4226-49c4-a59f-2b6b1f355bb4
@fileId = ed362f80-d294-471b-ab16-4e3404d23ab5
@nonExistentId = 00000000-0000-0000-0000-000000000000


### ============================================================
### 1. CREATE - Crear archivo (201 Created)
### ============================================================
# @name createFile
POST {{baseUrl}}{{apiPath}}
Content-Type: application/json

{
  "name": "reporte-anual.pdf",
  "extension": "pdf",
  "storagePath": "uploads/2026/reporte-anual.pdf",
  "sizeBytes": 102400,
  "accessLevel": "PRIVATE",
  "userId": "{{userId}}",
  "type": "AUDIO",
  "description": "Reporte anual de ventas 2026"
}



### ============================================================
### 2. CREATE - Nombre duplicado para el mismo usuario (409 Conflict)
### ============================================================
POST {{baseUrl}}{{apiPath}}
Content-Type: application/json

{
  "name": "reporte-anual.pdf",
  "extension": "pdf",
  "storagePath": "uploads/2026/reporte-anual-copia.pdf",
  "sizeBytes": 204800,
  "accessLevel": "PRIVATE",
  "userId": "{{userId}}",
  "type": "DOCUMENT",
  "description": "Copia con mismo nombre"
}


### ============================================================
### 3. CREATE - Mismo nombre pero distinto usuario (201 Created)
### Debe permitirse gracias al unique compuesto (name, user_id)
### ============================================================
POST {{baseUrl}}{{apiPath}}
Content-Type: application/json

{
  "name": "reporte-anual.pdf",
  "extension": "pdf",
  "storagePath": "uploads/2026/otro-usuario-reporte.pdf",
  "sizeBytes": 51200,
  "accessLevel": "SHARED",
  "userId": "{{userId2}}",
  "type": "DOCUMENT",
  "description": "Mismo nombre, otro usuario"
}


### ============================================================
### 4. CREATE - Usuario inexistente (404 Not Found)
### ============================================================
POST {{baseUrl}}{{apiPath}}
Content-Type: application/json

{
  "name": "archivo-huerfano.pdf",
  "extension": "pdf",
  "storagePath": "uploads/2026/huerfano.pdf",
  "sizeBytes": 1024,
  "accessLevel": "PRIVATE",
  "userId": "{{nonExistentId}}",
  "type": "DOCUMENT",
  "description": "Usuario que no existe"
}

### ============================================================
### 5. CREATE - Body inválido, campos vacíos (400 Bad Request)
### ============================================================
POST {{baseUrl}}{{apiPath}}
Content-Type: application/json

{
  "name": "",
  "extension": "pdf",
  "storagePath": "",
  "sizeBytes": -5,
  "accessLevel": null,
  "userId": "{{userId}}",
  "type": null,
  "description": "Body inválido"
}


### ============================================================
### 6. CREATE - Extensión demasiado larga (400 Bad Request)
### ============================================================
POST {{baseUrl}}{{apiPath}}
Content-Type: application/json

{
  "name": "archivo.pdf",
  "extension": "extension-demasiado-larga",
  "storagePath": "uploads/2026/x.pdf",
  "sizeBytes": 1024,
  "accessLevel": "PRIVATE",
  "userId": "{{userId}}",
  "type": "DOCUMENT",
  "description": "Extensión inválida"
}


### ============================================================
### 7. READ - Obtener por ID (200 OK)
### ============================================================
GET {{baseUrl}}{{apiPath}}/{{fileId}}
Accept: application/json


### ============================================================
### 8. READ - ID inexistente (404 Not Found)
### ============================================================
GET {{baseUrl}}{{apiPath}}/{{nonExistentId}}
Accept: application/json


### ============================================================
### 9. READ - ID con formato inválido (400 Bad Request)
### ============================================================
GET {{baseUrl}}{{apiPath}}/no-es-un-uuid
Accept: application/json


### ============================================================
### 10. READ - Listar todos (200 OK)
### ============================================================
GET {{baseUrl}}{{apiPath}}
Accept: application/json

### ============================================================
### 11. UPDATE - Actualizar archivo (200 OK)
### ============================================================
PUT {{baseUrl}}{{apiPath}}/{{fileId}}
Content-Type: application/json

{
  "name": "reporte-anual-v2.pdf",
  "extension": "pdf",
  "storagePath": "uploads/2026/reporte-anual-v2.pdf",
  "sizeBytes": 153600,
  "accessLevel": "PUBLIC",
  "userId": "{{userId}}",
  "type": "VIDEO",
  "description": "Versión 2 del reporte"
}


### ============================================================
### 12. UPDATE - Nombre ya en uso por otro archivo (409 Conflict)
### ============================================================
PUT {{baseUrl}}{{apiPath}}/{{fileId}}
Content-Type: application/json

{
  "name": "archivo-existente.pdf",
  "extension": "pdf",
  "storagePath": "uploads/2026/otro.pdf",
  "sizeBytes": 1024,
  "accessLevel": "PRIVATE",
  "userId": "{{userId}}",
  "type": "DOCUMENT",
  "description": "Intento de colisión de nombre"
}


### ============================================================
### 13. UPDATE - Archivo inexistente (404 Not Found)
### ============================================================
PUT {{baseUrl}}{{apiPath}}/{{nonExistentId}}
Content-Type: application/json

{
  "name": "no-importa.pdf",
  "extension": "pdf",
  "storagePath": "uploads/2026/x.pdf",
  "sizeBytes": 1024,
  "accessLevel": "PRIVATE",
  "userId": "{{userId}}",
  "type": "DOCUMENT",
  "description": "No existe"
}


### ============================================================
### 14. UPDATE - Body inválido (400 Bad Request)
### ============================================================
PUT {{baseUrl}}{{apiPath}}/{{fileId}}
Content-Type: application/json

{
  "name": "",
  "extension": "",
  "storagePath": "",
  "sizeBytes": null,
  "accessLevel": null,
  "userId": null,
  "type": null,
  "description": null
}



### ============================================================
### 15. DELETE - Eliminar archivo (204 No Content)
### ============================================================
DELETE {{baseUrl}}{{apiPath}}/{{fileId}}



### ============================================================
### 16. DELETE - Archivo ya eliminado / inexistente (404 Not Found)
### ============================================================
DELETE {{baseUrl}}{{apiPath}}/{{fileId}}



### ============================================================
### 17. DELETE - ID con formato inválido (400 Bad Request)
### ============================================================
DELETE {{baseUrl}}{{apiPath}}/no-es-un-uuid


### ============================================================
### FLUJO E2E COMPLETO
### Ejecutar en orden: 18 → 19 → 20 → 21 → 22
### ============================================================
